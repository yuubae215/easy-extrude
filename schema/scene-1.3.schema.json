{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-extrude.dev/schema/scene-1.3.json",
  "title": "SceneDTO",
  "description": "Shape contract for the /api/scenes persistence payload (SceneSerializer v1.3, ADR-015/016/038; ADR-064 Phase 3). Designed on the Blender datablock principle: the GRAPH SKELETON (objects with typed refs, SpatialLink edges, transformGraph nodes/edges) is protected with additionalProperties:false; bulk GEOMETRY (ImportedMesh position/normal/index buffers) rides as an opaque base64 blob leaf whose envelope is validated but whose contents are not (semantic sanity is the consumer's THREE.Mesh contract). The BFF stamps `version`. The MEANING contract (ref resolution across objects/links/graph) is deferred to the domain reconstruct path, not expressed here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objects"],
  "properties": {
    "version": {
      "const": "1.3",
      "description": "Scene JSON version. Bound to SCENE_JSON_VERSION; stamped by the BFF on write."
    },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "transformGraph": { "$ref": "#/$defs/transformGraph" },
    "operationGraph": {
      "type": "object",
      "description": "Geometry-service operation DAG (ADR-017 Phase B). Declared but kept open (additionalProperties:true): the DAG shape is dev-phase and slated for Phase C review — the same opaque-envelope treatment as the geometry blob (PHILOSOPHY #29 (b)).",
      "additionalProperties": true
    }
  },
  "$defs": {
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number" }
      }
    },
    "idVertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "base64Buffer": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "Opaque geometry buffer (base64 of a typed array). Envelope-validated only — vertex/index sanity is the consumer's THREE.Mesh contract, never re-checked on the wire."
    },
    "object": {
      "oneOf": [
        { "$ref": "#/$defs/solid" },
        { "$ref": "#/$defs/profile" },
        { "$ref": "#/$defs/measureLine" },
        { "$ref": "#/$defs/coordinateFrame" },
        { "$ref": "#/$defs/importedMesh" },
        { "$ref": "#/$defs/annotatedLine" },
        { "$ref": "#/$defs/annotatedRegion" },
        { "$ref": "#/$defs/annotatedPoint" }
      ]
    },
    "solid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "position", "orientation", "localCorners"],
      "properties": {
        "type": { "const": "Solid" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ifcClass": { "type": ["string", "null"] },
        "position": { "$ref": "#/$defs/vec3" },
        "orientation": { "$ref": "#/$defs/quaternion" },
        "localCorners": { "type": "array", "items": { "$ref": "#/$defs/vec3" } }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "Profile" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sketchRect": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["p1", "p2"],
              "properties": {
                "p1": { "$ref": "#/$defs/vec3" },
                "p2": { "$ref": "#/$defs/vec3" }
              }
            }
          ]
        }
      }
    },
    "measureLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "p1", "p2"],
      "properties": {
        "type": { "const": "MeasureLine" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "p1": { "$ref": "#/$defs/vec3" },
        "p2": { "$ref": "#/$defs/vec3" },
        "anchorRef0": { "type": ["string", "null"] },
        "anchorRef1": { "type": ["string", "null"] }
      }
    },
    "coordinateFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "translation", "rotation"],
      "properties": {
        "type": { "const": "CoordinateFrame" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "declaredBy": { "type": ["string", "null"] },
        "robotRole": {
          "description": "Declared role inside a robot's TF tree (ADR-090): 'base' | 'tcp' | null. Robot identity is the entity carrying this role, not the frame's name, so a scene can hold N robots.",
          "enum": ["base", "tcp", null]
        },
        "mountedOn": {
          "description": "ADR-151: what a robot tcp's translation/rotation are measured from. 'flange' = they ARE the tool mount (tool0 -> tcp), the interface the robot and its end effector share; the scene composes the tcp's world pose as base ∘ flange-at-rest ∘ mount. null/absent on every other frame, and on a pre-ADR-151 tcp (base-relative rest pose), which the scene-entry upgrade replaces with the default mount and announces.",
          "enum": ["flange", null]
        },
        "hand": {
          "description": "ADR-152 D3: WHAT a robot grasps with — only on a robot tcp (`robotRole: tcp`, `mountedOn: flange`), the interface the robot and its end effector share. The hand's kind, its grasp-gate parameters and, optionally, its SHAPE (a housing + two fingers, or a housing + a cup), in the Layout length unit (mm) in the FLANGE frame (+Z out of the flange face, jaws closing along ±X). The wire `gripper`, the arm's drawn tool and the hand preview are all derived from this one declaration. null/absent = the hand is UNDECLARED (never filled in with a default on read). The shape is optional; when declared it must agree with the tool mount (jaw: body length ≤ mount ≤ body + finger length; cup: mount = body length + cupHeight) or the search stops with the reason. Structural validity per kind (body+fingers / body+cupHeight together) is checked by the front's resolver, which reports a malformed hand rather than dropping it.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "parallelJaw",
                "suction"
              ]
            },
            "maxOpening": {
              "type": "number",
              "minimum": 0,
              "description": "Jaw: maximum opening (mm). The fingers are drawn and judged OPEN at this width."
            },
            "fingerClearance": {
              "type": "number",
              "minimum": 0,
              "description": "Jaw: extra clearance the fingers need beside the part (mm)."
            },
            "cupDiameter": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Cup: outside diameter (mm)."
            },
            "sealTiltTolerance": {
              "type": "number",
              "minimum": 0,
              "description": "Cup: seal tilt tolerance (radians)."
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "description": "The housing from the flange face to the palm: a cylinder (radius, length) or a box (size [x, y, z], z = length).",
              "properties": {
                "kind": {
                  "enum": [
                    "cylinder",
                    "box"
                  ]
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Cylinder radius (mm)."
                },
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Cylinder length along the flange +Z (mm)."
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Box full extents [x, y, z] (mm)."
                }
              }
            },
            "fingers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "length",
                "thickness",
                "width"
              ],
              "description": "Jaw: one finger — thickness along X, width along Y, length along Z from the palm (mm).",
              "properties": {
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "mm"
                },
                "thickness": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "mm"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "mm"
                }
              }
            },
            "cupHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Cup: height below the housing along the flange +Z (mm). The cup face is the TCP."
            }
          }
        },
        "translation": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quaternion" }
      }
    },
    "importedMesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "positions"],
      "properties": {
        "type": { "const": "ImportedMesh" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ifcClass": { "type": ["string", "null"] },
        "positions": { "$ref": "#/$defs/base64Buffer" },
        "normals": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/base64Buffer" }] },
        "indices": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/base64Buffer" }] },
        "offset": { "$ref": "#/$defs/vec3" }
      }
    },
    "annotatedLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "vertices"],
      "properties": {
        "type": { "const": "AnnotatedLine" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "placeType": { "type": ["string", "null"] },
        "vertices": { "type": "array", "items": { "$ref": "#/$defs/idVertex" } }
      }
    },
    "annotatedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "vertices"],
      "properties": {
        "type": { "const": "AnnotatedRegion" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "placeType": { "type": ["string", "null"] },
        "vertices": { "type": "array", "items": { "$ref": "#/$defs/idVertex" } }
      }
    },
    "annotatedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "vertex"],
      "properties": {
        "type": { "const": "AnnotatedPoint" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "placeType": { "type": ["string", "null"] },
        "vertex": { "$ref": "#/$defs/idVertex" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "sourceId", "targetId"],
      "properties": {
        "type": { "const": "SpatialLink" },
        "id": { "type": "string" },
        "sourceId": { "type": "string" },
        "targetId": { "type": "string" },
        "jointType": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["fixed", "revolute", "continuous", "prismatic", "floating", "planar"] }
          ]
        },
        "semanticType": {
          "enum": [
            "fastened", "mounts", "aligned",
            "contains", "adjacent", "above", "connects",
            "references", "represents", "bounded_by"
          ]
        },
        "properties": { "type": "object", "additionalProperties": true }
      }
    },
    "transformGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "objectId": { "type": "string" },
              "label": { "type": "string" },
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "translation": { "type": "array", "items": { "type": "number" } },
                  "rotation": { "type": "array", "items": { "type": "number" } }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "parentId", "childId"],
            "properties": {
              "id": { "type": "string" },
              "parentId": { "type": "string" },
              "childId": { "type": "string" },
              "constraint": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
