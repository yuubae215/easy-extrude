{
  "version": "context/0.2",
  "meta": {
    "name": "Robot cell, multi-party requirements — conflict & negotiation-cluster scenario (ADR-049)",
    "baseline": null
  },

  "actors": [
    { "ref": "mech_engineer",   "role": "developer" },
    { "ref": "robot_engineer",  "role": "developer" },
    { "ref": "vision_engineer", "role": "developer" }
  ],

  "sources": [
    { "ref": "src_kickoff",     "kind": "utterance", "by": "robot_engineer", "capturedAt": "2026-06-13" },
    { "ref": "src_zone_sketch", "kind": "sketch",    "by": "mech_engineer",  "capturedAt": "2026-06-13" }
  ],

  "given": [
    {
      "ref": "f_camera",
      "subject": "Hand-eye camera (5MP)",
      "attrs": {
        "sensor_px_h": { "value": 2448, "unit": "px" },
        "lens_focal":  { "value": 16,   "unit": "mm" }
      },
      "status": "asserted",
      "evidence": ["src_kickoff"]
    }
  ],

  "variables": [
    {
      "ref": "v_camera_standoff",
      "unit": "mm",
      "domain": [0, 2000],
      "description": "Distance from the hand-eye camera to the workpiece at the imaging pose (working distance)"
    },
    {
      "ref": "v_robot_base_x",
      "unit": "mm",
      "domain": [0, 3000],
      "description": "Robot base position along the cell depth"
    }
  ],

  "requirements": [
    {
      "ref": "r_cam_resolution",
      "by": "vision_engineer",
      "kpi": { "name": "resolution", "expr": "f_camera.attrs.sensor_px_h / fov_width(v_camera_standoff)", "unit": "px/mm" },
      "criterion": { "op": ">=", "value": 10 },
      "constrains": ["v_camera_standoff"],
      "negotiability": "should",
      "admissible": { "interval": [200, 350], "source": "stated" }
    },
    {
      "ref": "r_wrist_singularity",
      "by": "robot_engineer",
      "kpi": { "name": "singularityMargin", "expr": "wrist_margin(v_camera_standoff)", "unit": "deg" },
      "criterion": { "op": ">=", "value": 15 },
      "constrains": ["v_camera_standoff"],
      "negotiability": "must",
      "admissible": { "interval": [380, 600], "source": "stated" }
    },
    {
      "ref": "r_eoat_clearance",
      "by": "mech_engineer",
      "constrains": ["v_robot_base_x"],
      "negotiability": "must",
      "admissible": { "interval": [600, 1200], "source": "stated" },
      "evidence": ["src_zone_sketch"],
      "note": "From the 3D sketch — admissible mounting zone based on the end-effector volume beyond the flange. Supporting criterion not yet obtained (subject to R9)"
    },
    {
      "ref": "r_cycle_time",
      "by": "robot_engineer",
      "kpi": { "name": "cycleTime", "expr": "motion_time(v_robot_base_x, v_camera_standoff)", "unit": "s" },
      "criterion": { "op": "<=", "value": 8 },
      "constrains": ["v_robot_base_x", "v_camera_standoff"],
      "negotiability": "should"
    },
    {
      "ref": "r_cam_mount",
      "by": "vision_engineer",
      "kpi": { "name": "fovCoverage", "expr": "fov_cover(v_robot_base_x, v_camera_standoff)", "unit": "ratio" },
      "criterion": { "op": ">=", "value": 1.0 },
      "constrains": ["v_robot_base_x", "v_camera_standoff"],
      "negotiability": "must"
    }
  ],

  "decisions": [
    {
      "ref": "d_standoff",
      "resolves": "conflict_v_camera_standoff",
      "relaxes": {
        "requirement":  "r_cam_resolution",
        "oldCriterion": { "op": ">=", "value": 10 },
        "newCriterion": { "op": ">=", "value": 10 },
        "note": "Changing the lens f=16→25mm keeps 10px/mm even at WD400 (criterion unchanged; the KPI formula changes)"
      },
      "nominal": 400,
      "decidedBy": ["vision_engineer", "robot_engineer"],
      "status": "proposed",
      "rationale": "WD400: 17° singularity margin; the resolution requirement is met for +¥30k in lens cost"
    },
    {
      "ref": "d_cell_joint",
      "resolves": ["v_robot_base_x", "v_camera_standoff"],
      "nominals": { "v_robot_base_x": 900, "v_camera_standoff": 400 },
      "decidedBy": ["mech_engineer", "robot_engineer", "vision_engineer"],
      "status": "proposed",
      "rationale": "Joint settlement of the negotiation cluster (cycle time × FOV coverage) — cycle 7.2s / FOV coverage 1.05 confirmed by estimate"
    }
  ],

  "specification": {
    "layout": {
      "version": "layout/1.0",
      "meta": {
        "name": "Robot cell conflict scenario — minimal layout",
        "description": "Minimal spec containing only the admissible mounting zone from the mechanical engineer's 3D sketch."
      },
      "strategy": "manual",
      "entities": [
        {
          "ref": "robot_zone",
          "type": "AnnotatedRegion",
          "name": "Robot base admissible mounting zone (mechanical requirement)",
          "description": "Admissible mounting range derived from the end-effector volume requirement",
          "placeType": "Zone",
          "vertices": [
            { "x": 600,  "y": -300 },
            { "x": 1200, "y": -300 },
            { "x": 1200, "y":  300 },
            { "x": 600,  "y":  300 }
          ]
        }
      ],
      "constraints": []
    },

    "trace": [
      { "from": "r_eoat_clearance", "to": "robot_zone", "kind": "constrains" }
    ]
  },

  "acceptance": []
}
