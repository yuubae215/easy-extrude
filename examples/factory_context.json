{
  "version": "context/0.1",
  "meta": {
    "name": "Automating a cell-type process — requirement context",
    "baseline": null
  },

  "actors": [
    { "ref": "customer", "role": "customer" },
    { "ref": "sier",     "role": "developer" },
    { "ref": "maint",    "role": "maintainer" },
    { "ref": "operator", "role": "endUser" },
    { "ref": "broker",   "role": "agent" }
  ],

  "sources": [
    { "ref": "src_brief", "kind": "utterance", "by": "customer", "capturedAt": "2026-06-10" }
  ],

  "given": [
    {
      "ref": "f_cell_area",
      "subject": "Footprint of the cell-type process",
      "attrs": { "footprint": "unknown" },
      "status": "asserted",
      "evidence": ["src_brief"]
    },
    {
      "ref": "f_outlet",
      "subject": "Floor-mounted plant outlet",
      "attrs": {
        "voltage":        { "value": 100, "unit": "V" },
        "socket":         "3-prong socket",
        "ratedCurrent":   "unknown",
        "circuitSharing": "unknown"
      },
      "status": "asserted",
      "evidence": ["src_brief"]
    },
    {
      "ref": "f_outlet_to_bench",
      "subject": "Distance from the outlet to the workbench position (\"just under 3m\")",
      "quantity": { "interval": [2700, 3000], "unit": "mm" },
      "status": "asserted",
      "evidence": ["src_brief"]
    },
    {
      "ref": "f_bench",
      "subject": "Existing workbench",
      "attrs": {
        "height":       { "value": 800, "unit": "mm" },
        "top":          { "x": 500, "y": 300, "unit": "mm" },
        "loadCapacity": "unknown"
      },
      "status": "asserted",
      "evidence": ["src_brief"]
    },
    {
      "ref": "f_plate",
      "subject": "Base plate thickness requirement",
      "attrs": { "thickness": { "value": 30, "unit": "mm" } },
      "status": "asserted",
      "evidence": ["src_brief"]
    },
    {
      "ref": "f_bolt",
      "subject": "Robot fastening bolt spec",
      "attrs": { "spec": "M12 ×4" },
      "status": "assumed",
      "note": "Integrator's assumed value. Not yet confirmed by the customer / robot maker spec",
      "evidence": []
    }
  ],

  "intents": [
    {
      "ref": "g_automate",
      "verb": "replace",
      "summary": "Replace one cell process with an automated process"
    },
    {
      "ref": "g_depal",
      "verb": "depalletize_and_place",
      "inputs":  { "from": "container_a", "state": "Bulk (random) pile" },
      "outputs": { "to": "container_b", "state": "Aligned in a matrix grid" },
      "successCriteria": "Every workpiece is placed in a grid cell in the correct orientation",
      "parent": "g_automate"
    }
  ],

  "obligations": [
    {
      "ref": "o_baseplate_design",
      "deliverable": "Base plate design (30mm thick, mounted on the workbench top, robot fastening holes)",
      "responsible": "sier",
      "dependsOn": ["f_bench", "f_plate"],
      "defectScope": "Plate strength, hole position accuracy, fixing method to the top"
    },
    {
      "ref": "o_robot_select",
      "deliverable": "Robot model selection (100V supply, reaches both containers within the 500×300 top)",
      "responsible": "sier",
      "dependsOn": ["f_outlet", "f_bench"],
      "defectScope": "Reachability, payload, power compatibility"
    },
    {
      "ref": "o_robot_mount",
      "deliverable": "Bolting the robot onto the base plate",
      "responsible": "sier",
      "dependsOn": ["o_baseplate_design", "f_bolt"],
      "defectScope": "Fastening torque, loosening prevention"
    },
    {
      "ref": "o_power",
      "deliverable": "Power from the plant outlet (wiring the just-under-3m run)",
      "responsible": "unassigned",
      "dependsOn": ["f_outlet", "f_outlet_to_bench"],
      "defectScope": "unassigned"
    }
  ],

  "decisions": [
    {
      "ref": "d_bench_distance",
      "resolves": "f_outlet_to_bench",
      "nominal": 2800,
      "decidedBy": "sier",
      "status": "proposed",
      "rationale": "Nominal value that minimises cell depth while keeping wiring slack within the \"just under 3m\" run [2700, 3000)"
    },
    {
      "ref": "d_cell_bounds",
      "resolves": "f_cell_area",
      "nominal": [
        { "x": -600, "y": -700 },
        { "x": 3500, "y": -700 },
        { "x": 3500, "y":  700 },
        { "x": -600, "y":  700 }
      ],
      "decidedBy": "sier",
      "status": "proposed",
      "rationale": "The measured footprint is not yet available, so this is a proposed boundary back-calculated from the equipment layout"
    }
  ],

  "specification": {
    "layout": {
      "version": "layout/1.0",
      "meta": {
        "name": "Factory cell automation layout",
        "description": "A layout that replaces a cell-type process with an automated one. A robot and base plate sit on a workbench 2.8m from a floor-mounted 100V/3-prong outlet, with two workpiece containers in the bench's spare area."
      },
      "strategy": "manual",
      "entities": [
        {
          "ref": "cell_area",
          "type": "AnnotatedRegion",
          "name": "Automated cell footprint",
          "description": "Floor area occupied by the cell-type process",
          "placeType": "Zone",
          "vertices": { "$decision": "d_cell_bounds" }
        },
        {
          "ref": "floor_outlet",
          "type": "AnnotatedPoint",
          "name": "Floor outlet (100V / 3-prong socket)",
          "description": "Plant power. 100V, 3-prong socket.",
          "placeType": "Anchor",
          "position": { "x": 0, "y": 0, "z": 0 }
        },
        {
          "ref": "workbench",
          "type": "Solid",
          "name": "Workbench",
          "description": "800mm high, 500×300mm working area on top",
          "ifcClass": "IfcFurniture",
          "dimensions": {
            "x": { "$fact": "f_bench.attrs.top.x" },
            "y": { "$fact": "f_bench.attrs.top.y" },
            "z": { "$fact": "f_bench.attrs.height.value" }
          },
          "position": {
            "x": { "$decision": "d_bench_distance" },
            "y": 0,
            "z": { "$expr": "f_bench.attrs.height.value / 2" }
          },
          "frames": [
            {
              "ref": "workbench_top",
              "name": "Workbench top center",
              "translation": { "x": 0, "y": 0, "z": { "$expr": "f_bench.attrs.height.value / 2" } }
            }
          ]
        },
        {
          "ref": "base_plate",
          "type": "Solid",
          "name": "Robot mounting base plate (t30mm)",
          "description": "Robot mounting base plate fixed to the workbench top. 30mm thick.",
          "ifcClass": "IfcElementComponent",
          "dimensions": {
            "x": 300,
            "y": 250,
            "z": { "$fact": "f_plate.attrs.thickness.value" }
          },
          "position": {
            "x": 2650,
            "y": 0,
            "z": { "$expr": "f_bench.attrs.height.value + f_plate.attrs.thickness.value / 2" }
          },
          "frames": [
            {
              "ref": "robot_mount",
              "name": "Robot mounting surface (base plate top)",
              "translation": { "x": 0, "y": 0, "z": { "$expr": "f_plate.attrs.thickness.value / 2" } }
            }
          ]
        },
        {
          "ref": "robot_base",
          "type": "CoordinateFrame",
          "name": "robot_base",
          "description": "TF base of the industrial robot. Bolted to the base plate top (z=830, robot_mount).",
          "robotRole": "base",
          "position": {
            "x": 2650,
            "y": 0,
            "z": { "$expr": "f_bench.attrs.height.value + f_plate.attrs.thickness.value" }
          }
        },
        {
          "ref": "robot_tcp",
          "type": "CoordinateFrame",
          "name": "tcp",
          "description": "TCP of the industrial robot — the interface shared by the robot and the gripper. position is the tool mounting (tool0 → tcp, flange frame); the default gripper is 150 mm along flange +Z (the same default as a robot added with Shift+A). Its world position is derived from the arm pose (ADR-151).",
          "robotRole": "tcp",
          "parentRef": "robot_base",
          "mountedOn": "flange",
          "position": { "x": 0, "y": 0, "z": 150 }
        },
        {
          "ref": "container_a",
          "type": "Solid",
          "name": "Workpiece container A (bulk pile)",
          "description": "Placed in the area of the workbench top not occupied by the robot. Holds randomly piled workpieces.",
          "ifcClass": "IfcTransportElement",
          "dimensions": { "x": 180, "y": 120, "z": 150 },
          "position": {
            "x": 2950,
            "y": 90,
            "z": { "$expr": "f_bench.attrs.height.value + 150 / 2" }
          }
        },
        {
          "ref": "container_b",
          "type": "Solid",
          "name": "Workpiece container B (matrix grid)",
          "description": "Placed in the area of the workbench top not occupied by the robot. Holds a grid that aligns workpieces in a matrix.",
          "ifcClass": "IfcTransportElement",
          "dimensions": { "x": 180, "y": 120, "z": 150 },
          "position": {
            "x": 2950,
            "y": -90,
            "z": { "$expr": "f_bench.attrs.height.value + 150 / 2" }
          }
        }
      ],
      "constraints": [
        {
          "source": "base_plate",
          "target": "workbench",
          "jointType": null,
          "semanticType": "above",
          "properties": { "note": "Base plate bolted onto the workbench top" }
        },
        {
          "source": "robot_base",
          "target": "robot_mount",
          "jointType": "fixed",
          "semanticType": "fastened",
          "properties": { "note": "Robot bolted to the base plate (M12 ×4)" }
        },
        {
          "source": "container_a",
          "target": "workbench",
          "jointType": null,
          "semanticType": "above",
          "properties": { "note": "Container A sits beside the robot on the workbench top" }
        },
        {
          "source": "container_b",
          "target": "workbench",
          "jointType": null,
          "semanticType": "above",
          "properties": { "note": "Container B sits next to container A" }
        },
        {
          "source": "floor_outlet",
          "target": "workbench_origin",
          "jointType": null,
          "semanticType": "connects",
          "properties": {
            "distance_mm": { "$decision": "d_bench_distance" },
            "voltage_V":   { "$fact": "f_outlet.attrs.voltage.value" },
            "connector":   { "$fact": "f_outlet.attrs.socket" },
            "note":        "Power cable run from the floor outlet to the workbench"
          }
        }
      ]
    },

    "trace": [
      { "from": "d_cell_bounds",      "to": "cell_area",    "kind": "derives" },
      { "from": "f_outlet",           "to": "floor_outlet", "kind": "derives" },
      { "from": "f_bench",            "to": "workbench",    "kind": "derives" },
      { "from": "o_baseplate_design", "to": "base_plate",   "kind": "satisfies" },
      { "from": "f_plate",            "to": "base_plate",   "kind": "constrains" },
      { "from": "o_robot_select",     "to": "robot_base",   "kind": "satisfies" },
      { "from": "o_robot_select",     "to": "robot_tcp",    "kind": "satisfies" },
      { "from": "g_depal",            "to": "container_a",  "kind": "constrains" },
      { "from": "g_depal",            "to": "container_b",  "kind": "constrains" },
      { "from": "o_baseplate_design", "to": "constraint:base_plate→workbench",       "kind": "satisfies" },
      { "from": "o_robot_mount",      "to": "constraint:robot_base→robot_mount",     "kind": "satisfies" },
      { "from": "g_depal",            "to": "constraint:container_a→workbench",      "kind": "constrains" },
      { "from": "g_depal",            "to": "constraint:container_b→workbench",      "kind": "constrains" },
      { "from": "o_power",            "to": "constraint:floor_outlet→workbench_origin", "kind": "satisfies" },
      { "from": "f_outlet_to_bench",  "to": "constraint:floor_outlet→workbench_origin", "kind": "constrains" }
    ]
  },

  "acceptance": [
    {
      "ref": "a_plate_fit",
      "mode": "static",
      "predicate": "footprint_within(base_plate, workbench_top)",
      "requires": []
    },
    {
      "ref": "a_no_overlap",
      "mode": "static",
      "predicate": "no_overlap(robot, container_a, container_b) on workbench_top, clearance >= 0mm",
      "requires": []
    },
    {
      "ref": "a_cable",
      "mode": "static",
      "predicate": "cable_length(floor_outlet → robot_base) <= rated_cable",
      "evaluateAt": "worst_case(f_outlet_to_bench) = 3000mm",
      "requires": []
    },
    {
      "ref": "a_power",
      "mode": "witnessed",
      "predicate": "Current under real load <= outlet rated current",
      "requires": ["f_outlet.attrs.ratedCurrent"]
    },
    {
      "ref": "a_torque",
      "mode": "witnessed",
      "predicate": "Every fastening bolt is torqued within spec ± tolerance, with match marks applied",
      "requires": ["f_bolt"]
    },
    {
      "ref": "a_depal_cycle",
      "mode": "witnessed",
      "predicate": "g_depal.successCriteria met for N consecutive cycles",
      "requires": []
    }
  ]
}
